# Copy this file to .env and fill in your own values

# MongoDB connection string.
# Local MongoDB:      mongodb://127.0.0.1:27017/task-manager
# MongoDB Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/task-manager
MONGODB_URI=mongodb://127.0.0.1:27017/task-manager

# Port the API server listens on
PORT=5000

# Origin allowed to call this API (your frontend dev server)
CLIENT_ORIGIN=http://localhost:5173
